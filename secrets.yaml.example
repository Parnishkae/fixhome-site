# Пример файла секретов. Скопируй в secrets.yaml и впиши свой ключ,
# либо просто запусти:  python scripts\setup_ai.py
#
# ВАЖНО: secrets.yaml в git не попадает (см. .gitignore). Не публикуй ключи.

provider: "gemini"        # gemini | grok
api_key: "СЮДА-ТВОЙ-КЛЮЧ"
model: ""                 # пусто = голос по умолчанию (gemini-2.0-flash / grok-2-latest)
